---
import BaseLayout from '../layouts/BaseLayout.astro';
import AboutContact from '../components/AboutContact.astro';
import { site } from '../site.config';
---
<BaseLayout title="关于" description={`关于这个博客：${site.description}`} section="about">
  <section class="page-head"><h1>关于<span style="color:var(--accent)">.</span></h1><p>记录技术问题、实践过程和解决办法。</p></section>
  <div class="reading-width about-content"><div class="intro-panel"><h2>你好，我是 {site.author}。</h2>{site.about.map((paragraph) => <p>{paragraph}</p>)}</div>
  <section class="education-section" aria-labelledby="education-heading">
    <h2 id="education-heading">教育经历</h2>
    <div class="education-card">
      <div class="education-emblem"><img src={site.education.emblem} alt="华南师范大学校徽" width="66" height="72" loading="lazy" /></div>
      <div class="education-detail"><h3><a href={site.education.url} target="_blank" rel="noopener noreferrer">{site.education.school}<span aria-hidden="true"> ↗</span></a></h3><span class="education-degree">{site.education.degree}</span><p>{site.education.period}</p></div>
    </div>
  </section>
  {site.experience.length > 0 && <section class="about-section"><h2>经历</h2><div class="experience-list">{site.experience.map((item) => <div class="experience-item"><span>{item.period}</span><div><strong>{item.title}</strong><p>{item.detail}</p></div></div>)}</div></section>}
  <AboutContact locale="zh" />
  <section class="about-section"><h2>继续阅读</h2><p>想看看具体写了什么？可以从最近的文章开始。</p><a class="text-link" href="/blog/">浏览文章 ↗</a></section></div>
</BaseLayout>
<style>.about-content{padding-top:10px}.intro-panel{padding:38px;border:1px solid var(--line);border-radius:22px;background:var(--surface)}.intro-panel h2{font-size:2rem;letter-spacing:-.05em;margin:10px 0 20px}.intro-panel p,.about-section p{color:var(--muted);line-height:1.9}.education-section,.about-section{margin-top:55px}.education-section>h2,.about-section h2{font-size:1.5rem;letter-spacing:-.04em}.education-card{display:flex;align-items:center;gap:22px;padding:24px;border:1px solid var(--line);border-radius:20px;background:var(--surface);box-shadow:var(--shadow)}.education-emblem{flex:none;display:grid;place-items:center;width:94px;height:94px;border:1px solid var(--line);border-radius:16px;background:#fff}.education-emblem img{display:block;width:66px;height:72px;object-fit:contain}.education-degree{color:var(--muted);font-size:.84rem;font-weight:600}.education-detail h3{margin:2px 0;font-size:1.25rem;line-height:1.4}.education-detail h3 a:hover{color:var(--accent);text-decoration:underline;text-underline-offset:3px}.education-detail p{margin:0;color:var(--muted);font-size:.9rem}.experience-item{display:grid;grid-template-columns:130px 1fr;gap:20px;border-top:1px solid var(--line);padding:18px 0}.experience-item span{color:var(--muted)}.experience-item p{margin:3px 0}@media(max-width:700px){.intro-panel{padding:25px}.education-card{gap:15px;padding:18px}.education-emblem{width:76px;height:76px}.education-emblem img{width:54px;height:59px}.education-detail h3{font-size:1.08rem}.experience-item{grid-template-columns:1fr;gap:3px}}</style>
