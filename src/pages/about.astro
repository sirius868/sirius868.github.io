---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../site.config';
---
<BaseLayout title="关于" description={`认识 ${site.author}：${site.description}`} section="about">
  <section class="page-head"><div class="eyebrow">A LITTLE ABOUT ME</div><h1>关于我<span style="color:var(--accent)">.</span></h1><p>写作，让散落的想法有了可以相遇的地方。</p></section>
  <div class="reading-width about-content"><div class="intro-panel"><span class="eyebrow">HELLO, I'M {site.author.toUpperCase()}</span><h2>你好，我是 {site.author}。</h2>{site.about.map((paragraph) => <p>{paragraph}</p>)}</div>
  {site.experience.length > 0 && <section class="about-section"><h2>经历</h2><div class="experience-list">{site.experience.map((item) => <div class="experience-item"><span>{item.period}</span><div><strong>{item.title}</strong><p>{item.detail}</p></div></div>)}</div></section>}
  {site.links.length > 0 && <section class="about-section"><h2>找到我</h2><div class="link-list">{site.links.map((link) => <a href={link.url} target="_blank" rel="noopener noreferrer">{link.label} ↗</a>)}</div></section>}
  <section class="about-section"><h2>继续阅读</h2><p>想从文章开始认识我？可以看看最近写下的内容。</p><a class="text-link" href="/blog/">浏览文章 ↗</a></section></div>
</BaseLayout>
<style>.about-content{padding-top:10px}.intro-panel{padding:38px;border:1px solid var(--line);border-radius:22px;background:var(--surface)}.intro-panel h2{font-size:2rem;letter-spacing:-.05em;margin:10px 0 20px}.intro-panel p,.about-section p{color:var(--muted);line-height:1.9}.about-section{margin-top:55px}.about-section h2{font-size:1.5rem;letter-spacing:-.04em}.experience-item{display:grid;grid-template-columns:130px 1fr;gap:20px;border-top:1px solid var(--line);padding:18px 0}.experience-item span{color:var(--muted)}.experience-item p{margin:3px 0}.link-list{display:flex;flex-wrap:wrap;gap:10px}.link-list a{padding:9px 14px;border:1px solid var(--line);border-radius:9px;color:var(--accent)}@media(max-width:700px){.intro-panel{padding:25px}.experience-item{grid-template-columns:1fr;gap:3px}}</style>
