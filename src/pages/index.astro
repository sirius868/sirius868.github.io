---
import BaseLayout from '../layouts/BaseLayout.astro';
import ArticleCard from '../components/ArticleCard.astro';
import { getPublishedArticles } from '../lib/articles';
import { site } from '../site.config';

const articles = await getPublishedArticles();
const featured = articles.filter((article) => article.data.featured).slice(0, 2);
const featuredSlugs = new Set(featured.map((article) => article.data.slug));
const recent = articles.filter((article) => !featuredSlugs.has(article.data.slug)).slice(0, 4);
---
<BaseLayout title={site.name} description={site.description} section="home" homeHeaderSync>
  <div class="home-scroll-flow">
  <section class="hero home-panel" data-home-panel>
    <div class="hero-copy">
      <div class="eyebrow">NOTES ON BUILDING THINGS</div>
      <h1>你好，<br />来聊聊<em>技术</em><span class="hero-period">.</span></h1>
      <p>{site.intro}</p>
      <div class="hero-actions"><a class="button glow-button" data-glow-button href="/blog/"><span>阅读文章</span><span aria-hidden="true">↗</span></a><a class="button button-outline" href="/about/">了解我</a></div>
    </div>
    <div class="hero-art" aria-hidden="true"><span class="art-orbit orbit-one"></span><span class="art-orbit orbit-two"></span><span class="art-disc"></span><span class="art-star star-one">✳</span><span class="art-star star-two">✳</span><span class="art-caption">IDEAS GROW HERE</span></div>
  </section>
  {articles.length === 0 ? <div class="empty-state">文章正在路上，欢迎稍后再来。</div> : <>
    {featured.length > 0 && <section class="home-panel home-content-panel home-contrast-panel" data-home-panel data-home-contrast aria-labelledby="featured-heading"><div class="section-head"><div><div class="eyebrow">EDITOR'S PICK</div><h2 id="featured-heading">精选文章</h2></div><a href="/blog/">全部文章 ↗</a></div><div class="article-grid">{featured.map((article) => <ArticleCard article={article} />)}</div></section>}
    {recent.length > 0 && <section class="home-panel home-content-panel" data-home-panel aria-labelledby="recent-heading"><div class="section-head"><div><div class="eyebrow">LATEST STORIES</div><h2 id="recent-heading">最近写下</h2></div><a href="/blog/">浏览更多 ↗</a></div><div class="article-grid">{recent.map((article) => <ArticleCard article={article} />)}</div></section>}
  </>}
  <section class="closing home-panel home-contrast-panel" data-home-panel data-home-contrast><div class="eyebrow">KEEP EXPLORING</div><h2>有些问题，<br />值得认真拆解。</h2><p>把实践中的思路和踩过的坑写下来，希望能帮你更快找到方向。</p><a href="/about/" class="text-link">更多关于这个博客 ↗</a></section>
  </div>
</BaseLayout>

<style>
  .hero{min-height:520px;display:grid;grid-template-columns:1.1fr .9fr;gap:40px;align-items:center;padding:50px 0 36px}.hero-copy h1{font-size:clamp(3.6rem,8vw,6.6rem);line-height:1.07;letter-spacing:-.085em;margin:23px 0}.hero-copy h1 em{font-style:normal;color:var(--accent)}.hero-period{color:#888}.hero-copy p{max-width:485px;color:var(--muted);font-size:1.06rem;line-height:1.95}.hero-actions{display:flex;gap:11px;flex-wrap:wrap;margin-top:30px}.hero-art{height:390px;position:relative;display:grid;place-items:center;border-radius:32px;background:radial-gradient(circle at 70% 25%,var(--accent-soft),transparent 45%),linear-gradient(145deg,var(--soft),var(--surface));overflow:hidden;border:1px solid var(--line)}.art-disc{width:190px;height:190px;border-radius:50%;background:linear-gradient(140deg,#bcbcbc,#3d3d3d);box-shadow:24px 28px 0 rgba(0,0,0,.1),inset -20px -20px 40px rgba(0,0,0,.15);transform:rotate(-25deg)}.art-orbit{position:absolute;border:1px solid var(--accent);border-radius:50%;opacity:.25;transform:rotate(-30deg)}.orbit-one{width:280px;height:370px}.orbit-two{width:380px;height:250px}.art-star{position:absolute;color:#999;font-size:2rem}.star-one{top:60px;left:70px}.star-two{bottom:60px;right:65px;font-size:1.2rem}.art-caption{position:absolute;left:25px;bottom:21px;color:var(--muted);font-size:.67rem;letter-spacing:.2em;font-weight:700}.closing{margin-top:90px;padding:55px 45px;border-radius:24px;background:var(--accent-soft)}.closing h2{font-size:clamp(2rem,4vw,3.2rem);line-height:1.3;letter-spacing:-.05em;margin:13px 0}.closing p{color:var(--muted);margin-bottom:16px}@media(max-width:700px){.hero{grid-template-columns:1fr;gap:20px;padding:50px 0 20px;min-height:0}.hero-art{height:260px}.art-disc{width:140px;height:140px}.hero-copy h1{font-size:3.7rem}.closing{padding:35px 25px;margin-top:65px}}@media(max-width:360px){.hero-copy h1{font-size:3.2rem}}
</style>
<style>
  :global(html:has(.home-scroll-flow)){scroll-snap-type:y mandatory;scroll-padding-top:84px}
  .home-scroll-flow{position:relative}
  .home-panel{position:relative;min-height:calc(100svh - 84px);scroll-snap-align:start;scroll-snap-stop:always;isolation:isolate}
  :global(html:has(.home-scroll-flow) .site-footer){scroll-snap-align:start;margin-top:0}
  .home-panel.hero{min-height:calc(100svh - 102px)}
  .home-content-panel{display:flex;flex-direction:column;justify-content:center;padding:clamp(64px,9vh,110px) 0}
  .home-content-panel .section-head{margin-top:0}
  .home-contrast-panel{--ink:#f5f5f3;--muted:#b8b8ba;--line:#434346;--accent:#f5f5f3;--accent-soft:#303033;--soft:#272729;--surface:#222224;color:var(--ink)}
  .home-contrast-panel::before{content:'';position:absolute;z-index:-1;top:0;bottom:0;left:50%;width:100vw;transform:translateX(-50%);background:#111113}
  :global(html[data-theme=dark]) .home-contrast-panel{--ink:#19191b;--muted:#616166;--line:#d5d5d7;--accent:#19191b;--accent-soft:#e8e8e9;--soft:#f3f3f4;--surface:#fff}
  :global(html[data-theme=dark]) .home-contrast-panel::before{background:#f8f8f8}
  .home-content-panel .section-head h2{font-size:clamp(2.3rem,5vw,4.4rem);line-height:1.1;letter-spacing:-.065em}
  .home-contrast-panel .article-card{box-shadow:0 24px 70px rgba(0,0,0,.2)}
  .home-contrast-panel .article-card:hover{border-color:#8f8f94;box-shadow:0 28px 76px rgba(0,0,0,.3)}
  .home-contrast-panel .tag:hover{color:#fff}
  .home-panel.closing{display:flex;flex-direction:column;align-items:flex-start;justify-content:center;margin:0;padding:clamp(65px,10vh,110px) 0;border-radius:0;background:transparent}
  .home-panel.closing h2{font-size:clamp(2.8rem,6vw,5.5rem);line-height:1.13}
  .home-panel .section-head,.home-panel .article-grid,.closing>:not(:first-child){transition:opacity .75s cubic-bezier(.2,.7,.2,1),transform .9s cubic-bezier(.18,.72,.2,1)}
  :global(.home-motion-ready) .home-panel:not(.is-entered) .section-head,:global(.home-motion-ready) .home-panel:not(.is-entered) .article-grid,:global(.home-motion-ready) .closing:not(.is-entered)>:not(:first-child){opacity:.12;transform:translateY(54px)}
  :global(.home-motion-ready) .home-panel.is-entered .article-grid{transition-delay:.12s}
  :global(html.home-on-contrast .site-header){--ink:#f5f5f3;--muted:#c1c1c4;--line:#555559;--accent:#f5f5f3;--accent-soft:#333336;--surface:#242426;--bg:#111113;color:#f5f5f3;background:#111113}
  :global(html.home-on-contrast .site-header.is-scrolled){background:rgba(25,25,27,.9)}
  :global(html.home-on-contrast .site-header .brand-logo){filter:invert(1)}
  :global(html[data-theme=dark].home-on-contrast .site-header){--ink:#19191b;--muted:#616166;--line:#d5d5d7;--accent:#19191b;--accent-soft:#e8e8e9;--surface:#fff;--bg:#f8f8f8;color:#19191b;background:#f8f8f8}
  :global(html[data-theme=dark].home-on-contrast .site-header.is-scrolled){background:rgba(248,248,248,.9)}
  :global(html[data-theme=dark].home-on-contrast .site-header .brand-logo){filter:none}
  @media(max-width:700px){:global(html:has(.home-scroll-flow)){scroll-padding-top:68px}.home-panel{min-height:calc(100svh - 68px)}.home-panel.hero{min-height:calc(100svh - 78px)}.home-content-panel{padding:64px 0}.home-content-panel .section-head{align-items:flex-start}.home-content-panel .section-head h2{font-size:clamp(2.2rem,8vw,3.2rem)}.home-panel.closing{margin:0;padding:70px 0}}
  @media(prefers-reduced-motion:reduce){:global(html:has(.home-scroll-flow)){scroll-snap-type:none}.home-panel .section-head,.home-panel .article-grid,.closing>:not(:first-child){transition:none;opacity:1;transform:none}}
</style>
<style>
  .orbit-one{animation:orbit-clockwise 32s linear infinite;transform-origin:center}
  .orbit-two{animation:orbit-counterclockwise 42s linear infinite;transform-origin:center}
  .art-disc{animation:disc-float 6s ease-in-out infinite}
  .star-one{animation:star-breathe 4s ease-in-out infinite}
  .star-two{animation:star-breathe 4s ease-in-out -2s infinite}
  @keyframes orbit-clockwise{from{transform:rotate(-30deg)}to{transform:rotate(330deg)}}
  @keyframes orbit-counterclockwise{from{transform:rotate(-30deg)}to{transform:rotate(-390deg)}}
  @keyframes disc-float{0%,100%{transform:translateY(0) rotate(-25deg)}50%{transform:translateY(-12px) rotate(-22deg)}}
  @keyframes star-breathe{0%,100%{opacity:.55;transform:scale(.85)}50%{opacity:1;transform:scale(1.12)}}
  @media(prefers-reduced-motion:reduce){.art-orbit,.art-disc,.art-star{animation:none}}
</style>
<style>
  .glow-button{position:relative;overflow:hidden;isolation:isolate;--glow-x:50%;--glow-y:50%}
  .glow-button::before{content:'';position:absolute;inset:0;z-index:-1;background:radial-gradient(circle 75px at var(--glow-x) var(--glow-y),rgba(255,255,255,.38),transparent 80%);opacity:0;transition:opacity .25s ease;pointer-events:none}
  .glow-button:hover::before,.glow-button:focus-visible::before{opacity:1}
  .glow-button:hover{filter:none}
  @media(hover:none),(prefers-reduced-motion:reduce){.glow-button::before{display:none}}
</style>
<script>
  const glowButton = document.querySelector<HTMLElement>('[data-glow-button]');
  if (glowButton && matchMedia('(hover: hover) and (pointer: fine) and (prefers-reduced-motion: no-preference)').matches) {
    glowButton.addEventListener('pointermove', (event) => {
      const rect = glowButton.getBoundingClientRect();
      glowButton.style.setProperty('--glow-x', `${((event.clientX - rect.left) / rect.width) * 100}%`);
      glowButton.style.setProperty('--glow-y', `${((event.clientY - rect.top) / rect.height) * 100}%`);
    });
    glowButton.addEventListener('pointerleave', () => {
      glowButton.style.setProperty('--glow-x', '50%');
      glowButton.style.setProperty('--glow-y', '50%');
    });
  }
</script>
<script>
  const panels = [...document.querySelectorAll<HTMLElement>('[data-home-panel]')];
  if (panels.length) {
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let active = 0;
    let scrollFrame = 0;
    const updatePanels = () => {
      scrollFrame = 0;
      const marker = window.innerHeight * .44;
      const found = panels.findIndex((panel) => {
        const rect = panel.getBoundingClientRect();
        return rect.top <= marker && rect.bottom > marker;
      });
      if (found >= 0) active = found;
      panels.forEach((panel, index) => panel.classList.toggle('is-entered', index === active));
      document.documentElement.classList.toggle('home-on-contrast', Boolean(panels[active]?.hasAttribute('data-home-contrast') && found >= 0));
    };
    updatePanels();
    if (!reducedMotion.matches) document.documentElement.classList.add('home-motion-ready');
    window.addEventListener('scroll', () => {
      if (!scrollFrame) scrollFrame = requestAnimationFrame(updatePanels);
    }, { passive: true });
    window.addEventListener('resize', updatePanels, { passive: true });

    // A desktop wheel gesture advances one screen. Touch and reduced-motion users keep native scrolling.
    const desktopWheel = matchMedia('(min-width: 850px) and (hover: hover) and (pointer: fine)');
    let lastWheel = 0;
    let wheelLockedUntil = 0;
    window.addEventListener('wheel', (event) => {
      if (!desktopWheel.matches || reducedMotion.matches || event.ctrlKey || Math.abs(event.deltaY) < 12) return;
      const now = performance.now();
      const freshGesture = now - lastWheel > 230;
      lastWheel = now;
      const panel = panels[active];
      const next = active + Math.sign(event.deltaY);
      if (!panel || panel.getBoundingClientRect().height > window.innerHeight + 10) return;
      if (next < 0 || next >= panels.length) return;
      event.preventDefault();
      if (!freshGesture || now < wheelLockedUntil) return;
      wheelLockedUntil = now + 720;
      const top = window.scrollY + panels[next].getBoundingClientRect().top - 84;
      window.scrollTo({ top, behavior: 'smooth' });
    }, { passive: false });
  }
</script>
