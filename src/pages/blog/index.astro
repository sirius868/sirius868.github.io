---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import Pagination from '../../components/Pagination.astro';
import TagFilter from '../../components/TagFilter.astro';
import { getPublishedArticles, pageCount, pageSlice } from '../../lib/articles';

const articles = await getPublishedArticles();
const count = pageCount(articles.length);
const tags = [...new Set(articles.flatMap((article) => article.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title="文章" description="阅读关于 AI Agent、开发工具和工程实践的文章。" section="blog">
  <section class="page-head"><div class="eyebrow">ALL STORIES</div><h1>文章<span style="color:var(--accent)">.</span></h1><p>关于 AI Agent、开发工具和工程实践的一些记录。</p></section>
  <TagFilter tags={tags} currentPage />
  {articles.length > 0 ? <div class="article-grid paginated-grid">{pageSlice(articles, 1).map((article) => <ArticleCard article={article} />)}</div> : <div class="empty-state">暂时没有已发布的文章。</div>}
  <Pagination page={1} count={count} />
</BaseLayout>
