---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getPublishedArticles, dateText } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content } = await render(article);
---
<BaseLayout title={article.data.title} description={article.data.description} section="blog">
  <article class="reading-width">
    <header class="article-header"><a class="text-link" href="/blog/">← 返回文章</a><div class="article-meta"><time datetime={article.data.pubDate.toISOString()}>{dateText(article.data.pubDate)}</time></div><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="tag-list">{article.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></header>
    <div class="article-body"><Content /></div>
    <div class="article-end"><a class="text-link" href="/blog/">← 更多文章</a></div>
  </article>
</BaseLayout>
<style>.article-header{padding:69px 0 40px;border-bottom:1px solid var(--line);margin-bottom:42px}.article-header .article-meta{margin-top:30px}.article-header h1{font-size:clamp(2.5rem,5vw,4rem);line-height:1.22;letter-spacing:-.06em;margin:14px 0}.article-header>p{font-size:1.08rem;color:var(--muted);margin:0 0 18px}@media(max-width:700px){.article-header{padding-top:50px}.article-header h1{font-size:2.5rem}}</style>
