---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ReadingProgress from '../../components/ReadingProgress.astro';
import ArticleToc from '../../components/ArticleToc.astro';
import { getPublishedArticles, dateText } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return articles.map((article) => ({ params: { slug: article.data.slug }, props: { article } }));
}

const { article } = Astro.props;
const { Content, headings } = await render(article);
---
<BaseLayout title={article.data.title} description={article.data.description} section="blog" translated={false}>
  <div class="article-layout">
  <ArticleToc headings={headings} />
  <article class="reading-width">
    <header class="article-header"><a class="text-link" href="/blog/">← 返回文章</a><div class="article-meta"><time datetime={article.data.pubDate.toISOString()}>{dateText(article.data.pubDate)}</time></div><h1>{article.data.title}</h1><p>{article.data.description}</p><div class="tag-list">{article.data.tags.map((tag) => <a class="tag" href={`/tags/${encodeURIComponent(tag)}/`}>{tag}</a>)}</div></header>
    <div class="article-body" data-article-body><Content /></div>
    <div class="article-end"><a class="text-link" href="/blog/">← 更多文章</a></div>
  </article>
  </div>
  <ReadingProgress />
</BaseLayout>
<style>.article-layout{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,740px) minmax(0,1fr);gap:64px;width:min(1280px,calc(100vw - 48px));margin-left:50%;transform:translateX(-50%)}.article-layout article{grid-column:2;grid-row:1;width:100%}.article-layout :global(.article-toc){grid-column:1;grid-row:1;margin-top:70px}.article-layout :global(.article-toc-mobile){grid-column:1/-1;grid-row:1}.article-header{padding:69px 0 40px;border-bottom:1px solid var(--line);margin-bottom:42px}.article-header .article-meta{margin-top:30px}.article-header h1{font-size:clamp(2.5rem,5vw,4rem);line-height:1.22;letter-spacing:-.06em;margin:14px 0}.article-header>p{font-size:1.08rem;color:var(--muted);margin:0 0 18px}@media(max-width:1160px){.article-layout{display:block;width:100%;margin:0;transform:none}.article-layout article{width:100%}}@media(max-width:700px){.article-header{padding-top:50px}.article-header h1{font-size:2.5rem}}</style>
