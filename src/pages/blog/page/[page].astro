---
import BaseLayout from '../../../layouts/BaseLayout.astro';
import ArticleCard from '../../../components/ArticleCard.astro';
import Pagination from '../../../components/Pagination.astro';
import TagFilter from '../../../components/TagFilter.astro';
import { getPublishedArticles, pageCount, pageSlice } from '../../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  return Array.from({ length: Math.max(0, pageCount(articles.length) - 1) }, (_, index) => ({ params: { page: String(index + 2) } }));
}

const page = Number(Astro.params.page);
const articles = await getPublishedArticles();
const count = pageCount(articles.length);
const tags = [...new Set(articles.flatMap((article) => article.data.tags))].sort((a, b) => a.localeCompare(b, 'zh-CN'));
---
<BaseLayout title={`文章 · 第 ${page} 页`} description={`yhblog 的文章列表，第 ${page} 页。`} section="blog">
  <section class="page-head"><div class="eyebrow">ALL STORIES</div><h1>文章<span style="color:var(--accent)">.</span></h1><p>关于 AI Agent、开发工具和工程实践的一些记录。</p></section>
  <TagFilter tags={tags} />
  <div class="article-grid paginated-grid">{pageSlice(articles, page).map((article) => <ArticleCard article={article} />)}</div>
  <Pagination page={page} count={count} />
</BaseLayout>
