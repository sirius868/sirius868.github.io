---
import { render } from 'astro:content';
import BaseLayout from '../../../layouts/BaseLayout.astro';
import { dateText } from '../../../lib/articles';
import { getPublishedNotes } from '../../../lib/notes';
import { getEnglishTranslations } from '../../../lib/translations';
export async function getStaticPaths(){const notes=await getPublishedNotes();return notes.map((note)=>({params:{slug:note.data.slug},props:{note}}));}
const {note}=Astro.props;
const translations=await getEnglishTranslations();
const translation=translations.get(`notes:${note.data.slug}`);
const {Content}=await render(translation || note);
---
<BaseLayout title={translation?.data.title || note.data.title} description={translation?.data.description || note.data.description} locale="en" section="notes" contentLanguage={translation ? 'en' : 'zh'} translated={Boolean(translation)}>
  <article class="reading-width"><header class="en-article-header"><a class="text-link" href="/en/notes/">← Back to notes</a><div class="article-meta"><time datetime={note.data.pubDate.toISOString()}>{dateText(note.data.pubDate)}</time></div><h1>{translation?.data.title || note.data.title}</h1><p>{translation?.data.description || note.data.description}</p>{!translation && <p class="translation-notice">This note is available in Chinese only.</p>}</header><div class="article-body" lang={translation ? 'en' : 'zh-CN'}><Content /></div><div class="article-end"><a class="text-link" href="/en/notes/">← More notes</a></div></article>
</BaseLayout>
