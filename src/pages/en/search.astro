---
import BaseLayout from '../../layouts/BaseLayout.astro';
import SearchForm from '../../components/SearchForm.astro';
---
<BaseLayout title="Search" description="Search published articles, notes, and projects." locale="en" section="search">
  <section class="en-page-head"><div class="eyebrow">FIND SOMETHING INTERESTING</div><h1>Search.</h1><p>Find words in articles, notes, and projects.</p></section>
  <SearchForm locale="en" />
  <p id="search-status" role="status">Enter a keyword to search.</p>
  <div id="search-results" aria-live="polite"></div>
</BaseLayout>
<style>#search-status{color:var(--muted)}#search-results{display:grid;gap:26px}#search-results :global(.search-group-list){display:grid;gap:12px}#search-results :global(.search-result){display:block;padding:22px;border:1px solid var(--line);border-radius:14px;background:var(--surface)}#search-results :global(.search-result h3){margin:0 0 8px}#search-results :global(.search-result p){margin:0;color:var(--muted)}#search-results :global(.search-result small){color:var(--accent)}#search-results :global(.match-location){font-size:.78rem;font-weight:700}#search-results :global(.search-result mark){background:var(--accent-soft);color:var(--ink)}</style>
<script>
  import { searchContent, searchPreview, type SearchItem } from '../../lib/search';
  const input=document.querySelector<HTMLInputElement>('#query');
  const status=document.querySelector<HTMLElement>('#search-status');
  const results=document.querySelector<HTMLElement>('#search-results');
  const query=new URLSearchParams(location.search).get('q')?.trim() || '';
  if(input) input.value=query;
  if(query && status && results){
    status.textContent=`Searching for “${query}”…`;
    fetch('/en/search-index.json').then((response)=>{if(!response.ok) throw new Error('search index unavailable');return response.json() as Promise<SearchItem[]>}).then((items)=>{
      const matches=searchContent(items,query);
      status.textContent=matches.length?`${matches.length} result${matches.length===1?'':'s'} for “${query}”.`:`No results for “${query}”. Try another keyword.`;
      for(const [type,title] of [['article','Articles'],['note','Notes'],['project','Projects']] as const){
        const groupItems=matches.filter((item)=>item.type===type);
        if(!groupItems.length) continue;
        const group=document.createElement('section');group.className='search-group';group.setAttribute('aria-label',title);
        const groupHeading=document.createElement('h2');groupHeading.textContent=`${title} (${groupItems.length})`;
        const list=document.createElement('div');list.className='search-group-list';
        for(const item of groupItems){
          const preview=searchPreview(item,query);
          const link=document.createElement('a');link.className='search-result';link.href=`/en${preview.url}`;
          const heading=document.createElement('h3');heading.textContent=item.title;
          const position=document.createElement('p');position.className='match-location';position.textContent=`Found in: ${preview.location}`;
          const excerpt=document.createElement('p');excerpt.textContent=preview.excerpt;
          const date=document.createElement('small');date.textContent=new Date(item.date).toLocaleDateString('en-US',{year:'numeric',month:'short',day:'numeric',timeZone:'UTC'});
          link.append(heading,position,excerpt,date);list.append(link);
        }
        group.append(groupHeading,list);results.append(group);
      }
    }).catch(()=>{status.textContent='Search is temporarily unavailable.'});
  }
</script>
