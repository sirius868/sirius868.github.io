---
import { render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { dateText } from '../../lib/articles';
import { getPublishedNotes } from '../../lib/notes';

export async function getStaticPaths() {
  const notes = await getPublishedNotes();
  return notes.map((note) => ({ params: { slug: note.data.slug }, props: { note } }));
}

const { note } = Astro.props;
const { Content } = await render(note);
---
<BaseLayout title={note.data.title} description={note.data.description} section="notes" translated={false}>
  <article class="reading-width note-detail"><header><a class="text-link" href="/notes/">← 返回笔记</a><time datetime={note.data.pubDate.toISOString()}>{dateText(note.data.pubDate)}</time><h1>{note.data.title}</h1><p>{note.data.description}</p></header><div class="article-body"><Content /></div><div class="article-end"><a class="text-link" href="/notes/">← 更多笔记</a></div></article>
</BaseLayout>
<style>.note-detail header{padding:65px 0 30px;margin-bottom:38px;border-bottom:1px solid var(--line)}.note-detail time{display:block;color:var(--muted);font-size:.83rem;margin-top:30px}.note-detail h1{font-size:clamp(2.3rem,5vw,3.6rem);line-height:1.25;letter-spacing:-.055em;margin:10px 0}.note-detail header p{color:var(--muted);margin:0}@media(max-width:700px){.note-detail header{padding-top:45px}}</style>
