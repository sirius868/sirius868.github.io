---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleCard from '../../components/ArticleCard.astro';
import { getPublishedArticles } from '../../lib/articles';

export async function getStaticPaths() {
  const articles = await getPublishedArticles();
  const tags = [...new Set(articles.flatMap((article) => article.data.tags))];
  return tags.map((tag) => ({ params: { tag }, props: { tag } }));
}

const { tag } = Astro.props;
const articles = (await getPublishedArticles()).filter((article) => article.data.tags.includes(tag));
---
<BaseLayout title={`${tag} · 标签`} description={`阅读 yhblog 中关于「${tag}」的文章。`} section="blog">
  <section class="page-head"><div class="eyebrow">ARTICLES BY TOPIC</div><h1>{tag}<span style="color:var(--accent)">.</span></h1><p>共 {articles.length} 篇文章。<a class="text-link" href="/blog/">查看全部文章 ↗</a></p></section>
  <div class="article-grid">{articles.map((article) => <ArticleCard article={article} />)}</div>
</BaseLayout>
