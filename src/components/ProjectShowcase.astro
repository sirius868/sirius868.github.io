---
import type { Project } from '../lib/projects';
import type { Translation } from '../lib/translations';
import type { Locale } from '../lib/locale';

interface Props {
  projects: Project[];
  translations: Map<string, Translation>;
  locale: Locale;
}

const { projects, translations, locale } = Astro.props;
const en = locale === 'en';
const prefix = en ? '/en' : '';
const labels = en
  ? { title: 'Projects', intro: 'Things I have built, with the problems, decisions, and tradeoffs behind them.', selected: 'Selected work', details: 'View project', visit: 'Visit site', source: 'Source code', previous: 'Previous project', next: 'Next project', empty: 'Projects will appear here as they are published.', original: 'Chinese content' }
  : { title: '项目', intro: '记录做过的项目，以及背后的问题、实现和取舍。', selected: '项目展示', details: '查看项目', visit: '访问网站', source: '查看源码', previous: '上一个项目', next: '下一个项目', empty: '项目发布后会展示在这里。', original: '暂无英文版' };
const title = (project: Project) => en ? translations.get(`projects:${project.data.slug}`)?.data.title ?? project.data.title : project.data.title;
const description = (project: Project) => en ? translations.get(`projects:${project.data.slug}`)?.data.description ?? project.data.description : project.data.description;
---
<section class="projects-head">
  <div class="eyebrow">SELECTED WORK</div>
  <h1>{labels.title}<span>.</span></h1>
  <p>{labels.intro}</p>
</section>

{projects.length ? <section class="project-showcase" data-project-showcase aria-label={labels.selected}>
  <div class="showcase-topline"><span>{labels.selected}</span><span data-deck-count>01 / {String(projects.length).padStart(2, '0')}</span></div>
  <div class="deck-stage">
    {projects.map((project, index) => <article class="deck-card" data-deck-card data-state={index === 0 ? 'front' : 'back'} aria-hidden={index === 0 ? undefined : 'true'} inert={index === 0 ? undefined : true}>
      <div class="project-copy">
        <div class="project-category"><span class="status-dot" aria-hidden="true"></span>{project.data.category} <span class="separator">/</span> {project.data.year}</div>
        <h2>{title(project)}</h2>
        <p>{description(project)}</p>
        {en && !translations.has(`projects:${project.data.slug}`) && <small class="translation-note">{labels.original}</small>}
        <div class="stack-list" aria-label={en ? 'Technologies' : '技术栈'}>{project.data.stack.map((tech) => <span>{tech}</span>)}</div>
        <div class="project-actions">
          <a class="project-primary" href={`${prefix}/projects/${project.data.slug}/`}>{labels.details} <span aria-hidden="true">↗</span></a>
          {project.data.website && <a class="project-secondary" href={project.data.website} target="_blank" rel="noopener noreferrer">{labels.visit} <span aria-hidden="true">↗</span></a>}
          {project.data.repository && <a class="project-secondary" href={project.data.repository} target="_blank" rel="noopener noreferrer">{labels.source} <span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <div class="project-visual" aria-hidden="true">
        {project.data.slug === 'blog-site'
          ? <div class="preview-window"><div class="preview-bar"><span>● ● ●</span><span>sirius868.github.io</span><span>•••</span></div><div class="preview-body"><div class="preview-nav"><b>blog</b><span>文章　笔记　项目</span></div><div class="preview-hero"><small>NOTES ON BUILDING THINGS</small><strong>你好，<br />来聊聊技术<span>.</span></strong><i></i><i></i></div><div class="preview-tiles"><span></span><span></span></div></div></div>
          : <div class="system-diagram"><div class="diagram-heading">{project.data.title.toUpperCase()} <span>{project.data.year}</span></div><div class="diagram-flow">{(project.data.slug === 'whalemall' ? ['订单', '库存预占', '支付确认'] : en ? ['Problem', 'Build', 'Result'] : ['问题', '实现', '结果']).map((step, stepIndex) => <><span>{step}</span>{stepIndex < 2 && <i>→</i>}</>)}</div><div class="diagram-rule"></div><div class="diagram-layers">{project.data.stack.slice(0, 3).map((tech) => <span>{tech}</span>)}</div><div class="diagram-caption">{project.data.category.toUpperCase()}</div></div>}
        <span class="visual-caption">{String(index + 1).padStart(2, '0')} — {project.data.slug.toUpperCase()}</span>
      </div>
    </article>)}
  </div>
  {projects.length > 1 && <div class="deck-controls">
    <div class="deck-tabs" role="group" aria-label={en ? 'Choose project' : '选择项目'}>{projects.map((project, index) => <button type="button" class="deck-tab" data-deck-tab={index} aria-current={index === 0 ? 'true' : undefined}><span>{String(index + 1).padStart(2, '0')}</span>{title(project)}</button>)}</div>
    <div class="deck-arrows"><button type="button" data-deck-prev aria-label={labels.previous}>←</button><button type="button" data-deck-next aria-label={labels.next}>→</button></div>
  </div>}
  <p class="sr-only" role="status" aria-live="polite" data-deck-status></p>
</section> : <div class="projects-empty">{labels.empty}</div>}

<style>
  .projects-head{padding:74px 0 55px;max-width:720px}.projects-head h1{font-size:clamp(3rem,7vw,5.2rem);letter-spacing:-.075em;line-height:1.12;margin:14px 0}.projects-head h1 span{color:var(--muted)}.projects-head p{margin:0;color:var(--muted);font-size:1.08rem}.showcase-topline{display:flex;justify-content:space-between;gap:15px;margin-bottom:18px;color:var(--muted);font-size:.78rem;font-weight:700;letter-spacing:.12em}.deck-stage{display:grid;isolation:isolate;margin-right:20px;perspective:1100px}.deck-card{grid-area:1/1;display:grid;grid-template-columns:minmax(0,.9fr) minmax(0,1.1fr);min-height:470px;border:1px solid var(--line);border-radius:25px;overflow:hidden;background:var(--surface);box-shadow:0 22px 45px rgba(0,0,0,.07);transform-origin:50% 90%;transition:transform .55s cubic-bezier(.2,.75,.18,1),opacity .4s ease,box-shadow .4s ease;will-change:transform}.deck-card[data-state=front]{z-index:3;transform:translate3d(0,0,0) rotate(0) scale(1);opacity:1}.deck-card[data-state=back]{z-index:1;transform:translate3d(18px,-13px,-65px) rotate(2deg) scale(.97);opacity:.5;pointer-events:none}.deck-card[data-state=leaving]{z-index:4;transform:translate3d(-95px,20px,90px) rotate(-8deg) scale(.94);opacity:0;pointer-events:none}.project-copy{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(28px,5vw,55px)}.project-category{color:var(--muted);font-size:.83rem;font-weight:600}.status-dot{display:inline-block;width:7px;height:7px;margin-right:9px;border-radius:50%;background:var(--ink);vertical-align:middle}.separator{margin:0 8px;color:var(--line)}.project-copy h2{font-size:clamp(2.7rem,5vw,4.1rem);letter-spacing:-.075em;line-height:1.15;margin:35px 0 15px}.project-copy>p{max-width:410px;color:var(--muted);font-size:1.02rem;line-height:1.85;margin:0 0 27px}.stack-list{display:flex;flex-wrap:wrap;gap:7px}.stack-list span{padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:var(--soft);color:var(--muted);font-size:.76rem;font-weight:600;line-height:1.3}.project-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:32px}.project-primary,.project-secondary{display:inline-flex;align-items:center;gap:12px;min-height:43px;padding:9px 15px;border:1px solid var(--line);border-radius:10px;font-size:.85rem;font-weight:700;transition:transform .2s ease,box-shadow .2s ease}.project-primary{background:var(--ink);border-color:var(--ink);color:var(--bg)}.project-secondary{background:var(--surface);color:var(--ink)}.project-primary:hover,.project-secondary:hover{transform:translateY(-2px);box-shadow:0 7px 18px rgba(0,0,0,.1)}.project-visual{position:relative;display:grid;place-items:center;min-width:0;overflow:hidden;border-left:1px solid var(--line);background:radial-gradient(circle at 75% 25%,var(--surface),transparent 40%),linear-gradient(140deg,var(--soft),var(--accent-soft))}.project-visual::before{content:'';position:absolute;width:430px;height:430px;top:-38%;right:-38%;border:1px solid var(--line);border-radius:50%}.preview-window{position:relative;width:min(82%,410px);aspect-ratio:1.26;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:0 24px 65px rgba(0,0,0,.16);transform:rotate(-4deg);overflow:hidden}.preview-bar{display:flex;align-items:center;justify-content:space-between;gap:8px;height:31px;padding:0 11px;border-bottom:1px solid var(--line);color:var(--muted);font-size:9px}.preview-bar span:nth-child(2){overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.preview-body{padding:15px 19px}.preview-nav{display:flex;justify-content:space-between;gap:8px;padding-bottom:12px;border-bottom:1px solid var(--line);font-size:9px}.preview-nav b{font-size:13px}.preview-nav span{color:var(--muted)}.preview-hero{padding:26px 9px 18px}.preview-hero small{display:block;color:var(--muted);font-size:7px;letter-spacing:.14em}.preview-hero strong{display:block;margin:9px 0 13px;font-size:clamp(20px,3vw,37px);letter-spacing:-.08em;line-height:1.25}.preview-hero strong span{color:var(--muted)}.preview-hero i{display:block;width:73%;height:4px;margin:7px 0;border-radius:5px;background:var(--line)}.preview-hero i:last-child{width:52%}.preview-tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 9px}.preview-tiles span{height:30px;border:1px solid var(--line);border-radius:5px;background:var(--soft)}.system-diagram{position:relative;width:min(79%,410px);padding:27px;border:1px solid var(--line);border-radius:18px;background:var(--surface);box-shadow:0 23px 60px rgba(0,0,0,.13);transform:rotate(-3deg)}.diagram-heading{display:flex;justify-content:space-between;font-size:.73rem;font-weight:700;letter-spacing:.15em}.diagram-heading span{color:var(--muted)}.diagram-flow{display:flex;align-items:center;justify-content:space-between;gap:4px;margin:45px 0 28px}.diagram-flow span{padding:11px 8px;border:1px solid var(--line);border-radius:9px;background:var(--soft);font-size:.75rem;font-weight:700;white-space:nowrap}.diagram-flow i{color:var(--muted);font-style:normal}.diagram-rule{height:1px;background:var(--line)}.diagram-layers{display:flex;flex-wrap:wrap;gap:7px;margin-top:20px}.diagram-layers span{padding:5px 9px;border-radius:6px;background:var(--accent-soft);font-size:.7rem}.diagram-caption{margin-top:35px;color:var(--muted);font-size:.62rem;letter-spacing:.18em}.visual-caption{position:absolute;right:21px;bottom:18px;color:var(--muted);font-size:.67rem;font-weight:700;letter-spacing:.12em}.deck-controls{display:flex;align-items:center;justify-content:space-between;gap:15px;margin-top:28px}.deck-tabs{display:flex;flex-wrap:wrap;gap:9px}.deck-tab,.deck-arrows button{border:1px solid var(--line);background:var(--surface);color:var(--muted);transition:transform .2s ease,background-color .2s ease,border-color .2s ease}.deck-tab{min-height:42px;padding:8px 13px;border-radius:10px;font-size:.85rem;font-weight:700}.deck-tab span{margin-right:9px;font-size:.7rem;color:var(--muted)}.deck-tab[aria-current=true]{background:var(--accent-soft);color:var(--ink);border-color:var(--muted)}.deck-tab:hover,.deck-arrows button:hover{transform:translateY(-2px);border-color:var(--muted)}.deck-arrows{display:flex;gap:8px}.deck-arrows button{width:43px;height:43px;border-radius:10px;font-size:1.15rem;color:var(--ink)}.projects-empty{padding:55px 28px;border:1px dashed var(--line);border-radius:18px;color:var(--muted);text-align:center}
  @media(max-width:850px){.deck-card{grid-template-columns:1fr}.project-visual{grid-row:1;min-height:300px;border-left:0;border-bottom:1px solid var(--line)}.project-copy h2{margin-top:20px}.project-actions{padding-top:28px}}@media(max-width:700px){.projects-head{padding:54px 0 35px}.deck-stage{margin-right:12px}.deck-card{border-radius:20px}.project-visual{min-height:250px}.preview-window{width:min(75%,320px)}.preview-hero{padding-top:18px}.preview-hero strong{font-size:24px}.project-copy{padding:27px}.visual-caption{font-size:.57rem}.deck-controls{align-items:flex-start}.deck-tabs{max-width:calc(100% - 100px)}.deck-tab{font-size:.78rem;padding:7px 9px}.deck-arrows button{width:39px;height:39px}}@media(max-width:400px){.project-visual{min-height:220px}.preview-hero{padding:10px 5px 0}.preview-hero strong{font-size:19px;margin:5px 0}.preview-hero i,.preview-tiles{display:none}.system-diagram{width:83%;padding:16px}.diagram-flow{margin:23px 0 16px}.diagram-flow span{padding:6px 4px;font-size:.55rem}.diagram-layers{margin-top:11px}.diagram-layers span{font-size:.57rem}.diagram-caption{margin-top:15px}.deck-controls{flex-direction:column}.deck-tabs{max-width:100%}.deck-arrows{align-self:flex-end}}
  @media(prefers-reduced-motion:reduce){.deck-card,.deck-tab,.deck-arrows button,.project-primary,.project-secondary{transition:none}.deck-tab:hover,.deck-arrows button:hover,.project-primary:hover,.project-secondary:hover{transform:none}}
</style>
<script>
  const showcase = document.querySelector<HTMLElement>('[data-project-showcase]');
  if (showcase) {
    const cards = [...showcase.querySelectorAll<HTMLElement>('[data-deck-card]')];
    const tabs = [...showcase.querySelectorAll<HTMLButtonElement>('[data-deck-tab]')];
    const count = showcase.querySelector<HTMLElement>('[data-deck-count]');
    const status = showcase.querySelector<HTMLElement>('[data-deck-status]');
    const reducedMotion = matchMedia('(prefers-reduced-motion: reduce)');
    let current = 0;
    let timer: number | undefined;
    const show = (next: number) => {
      if (next === current || !cards[next]) return;
      if (timer) window.clearTimeout(timer);
      const previous = current;
      current = next;
      cards.forEach((card, index) => {
        card.inert = index !== current;
        if (index === current) card.removeAttribute('aria-hidden');
        else card.setAttribute('aria-hidden', 'true');
        card.dataset.state = index === current ? 'front' : index === previous && !reducedMotion.matches ? 'leaving' : 'back';
      });
      if (!reducedMotion.matches) timer = window.setTimeout(() => { if (cards[previous]) cards[previous].dataset.state = 'back'; }, 420);
      tabs.forEach((tab, index) => index === current ? tab.setAttribute('aria-current', 'true') : tab.removeAttribute('aria-current'));
      if (count) count.textContent = `${String(current + 1).padStart(2, '0')} / ${String(cards.length).padStart(2, '0')}`;
      if (status) status.textContent = tabs[current]?.textContent?.trim() || '';
    };
    tabs.forEach((tab, index) => tab.addEventListener('click', () => show(index)));
    showcase.querySelector('[data-deck-prev]')?.addEventListener('click', () => show((current - 1 + cards.length) % cards.length));
    showcase.querySelector('[data-deck-next]')?.addEventListener('click', () => show((current + 1) % cards.length));
  }
</script>
