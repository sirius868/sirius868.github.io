---
import type { Project } from '../lib/projects';
import type { Translation } from '../lib/translations';
import type { Locale } from '../lib/locale';

interface Props {
  projects: Project[];
  translations: Map<string, Translation>;
  locale: Locale;
}

const { projects, translations, locale } = Astro.props;
const featured = projects.find((project) => project.data.featured) ?? projects[0];
const others = projects.filter((project) => project !== featured);
const en = locale === 'en';
const prefix = en ? '/en' : '';
const content = en
  ? { eyebrow: 'SELECTED WORK', title: 'Projects', intro: 'Things I have built, with the problems, decisions, and tradeoffs behind them.', featured: 'Featured project', more: 'More projects', details: 'View project', source: 'Source code', visit: 'Visit site', empty: 'Projects will appear here as they are published.', original: 'Chinese content' }
  : { eyebrow: 'SELECTED WORK', title: '项目', intro: '记录做过的项目，以及背后的问题、实现和取舍。', featured: '重点项目', more: '更多项目', details: '查看项目', source: '查看源码', visit: '访问网站', empty: '项目发布后会展示在这里。', original: '暂无英文版' };
const name = (project: Project) => en ? translations.get(`projects:${project.data.slug}`)?.data.title ?? project.data.title : project.data.title;
const description = (project: Project) => en ? translations.get(`projects:${project.data.slug}`)?.data.description ?? project.data.description : project.data.description;
---
<section class="projects-head">
  <div class="eyebrow">{content.eyebrow}</div>
  <h1>{content.title}<span>.</span></h1>
  <p>{content.intro}</p>
</section>

{featured ? <>
  <section class="featured-section" aria-labelledby="featured-project-title">
    <div class="section-label"><span>{content.featured}</span><span>01 / {String(projects.length).padStart(2, '0')}</span></div>
    <div class="featured-project">
      <div class="featured-copy">
        <div class="project-category"><span class="status-dot" aria-hidden="true"></span>{featured.data.category} <span class="category-separator">/</span> {featured.data.year}</div>
        <h2 id="featured-project-title">{name(featured)}</h2>
        <p>{description(featured)}</p>
        {en && !translations.has(`projects:${featured.data.slug}`) && <small class="translation-note">{content.original}</small>}
        <div class="stack-list" aria-label={en ? 'Technologies' : '技术栈'}>{featured.data.stack.map((tech) => <span>{tech}</span>)}</div>
        <div class="project-actions">
          <a class="project-primary" href={`${prefix}/projects/${featured.data.slug}/`}>{content.details}<span aria-hidden="true">↗</span></a>
          {featured.data.website && <a class="project-secondary" href={featured.data.website} target="_blank" rel="noopener noreferrer">{content.visit}<span aria-hidden="true">↗</span></a>}
          {featured.data.repository && <a class="project-secondary" href={featured.data.repository} target="_blank" rel="noopener noreferrer">{content.source}<span aria-hidden="true">↗</span></a>}
        </div>
      </div>
      <div class="project-visual" aria-hidden="true">
        <div class="visual-orbit"></div>
        <div class="preview-window">
          <div class="preview-bar"><span class="preview-dots"><i></i><i></i><i></i></span><span class="preview-url">{featured.data.website ? new URL(featured.data.website).hostname : featured.data.slug}</span><span class="preview-menu">•••</span></div>
          <div class="preview-body"><div class="preview-nav"><b>blog</b><span>文章　笔记　项目</span></div><div class="preview-hero"><span>NOTES ON BUILDING THINGS</span><strong>你好，<br />来聊聊技术<span>.</span></strong><i></i><i></i></div><div class="preview-tiles"><span></span><span></span></div></div>
        </div>
        <span class="visual-caption">01 — {featured.data.slug.toUpperCase()}</span>
      </div>
    </div>
  </section>
  {others.length > 0 && <section class="more-projects" aria-labelledby="more-projects-title"><div class="section-label"><h2 id="more-projects-title">{content.more}</h2><span>02 — {String(projects.length).padStart(2, '0')}</span></div><div class="project-grid">{others.map((project, index) => <article class="project-card"><div class="card-number">{String(index + 2).padStart(2, '0')} / {String(projects.length).padStart(2, '0')}</div><div class="card-symbol" aria-hidden="true">{project.data.title.slice(0, 1).toUpperCase()}</div><div class="card-meta">{project.data.category} · {project.data.year}</div><h3><a href={`${prefix}/projects/${project.data.slug}/`}>{name(project)} <span aria-hidden="true">↗</span></a></h3><p>{description(project)}</p><div class="card-bottom"><div class="stack-list">{project.data.stack.slice(0, 3).map((tech) => <span>{tech}</span>)}</div><a href={`${prefix}/projects/${project.data.slug}/`} aria-label={`${content.details}：${name(project)}`}>{content.details} →</a></div></article>)}</div></section>}
</> : <div class="projects-empty">{content.empty}</div>}

<style>
  .projects-head{padding:74px 0 55px;max-width:720px}.projects-head h1{font-size:clamp(3rem,7vw,5.2rem);letter-spacing:-.075em;line-height:1.12;margin:14px 0}.projects-head h1 span{color:var(--muted)}.projects-head p{margin:0;color:var(--muted);font-size:1.08rem}.section-label{display:flex;align-items:center;justify-content:space-between;gap:20px;margin-bottom:16px;color:var(--muted);font-size:.77rem;font-weight:700;letter-spacing:.13em;text-transform:uppercase}.section-label h2{font-size:1.5rem;letter-spacing:-.04em;text-transform:none;color:var(--ink);margin:0}.featured-project{display:grid;grid-template-columns:minmax(0, .9fr) minmax(0,1.1fr);min-height:460px;border:1px solid var(--line);border-radius:26px;overflow:hidden;background:var(--surface);box-shadow:var(--shadow)}.featured-copy{display:flex;flex-direction:column;align-items:flex-start;padding:clamp(28px,5vw,58px)}.project-category,.card-meta{color:var(--muted);font-size:.83rem;font-weight:600}.status-dot{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--ink);margin-right:9px;vertical-align:middle}.category-separator{margin:0 7px;color:var(--line)}.featured-copy h2{font-size:clamp(2.8rem,5vw,4.3rem);line-height:1.15;letter-spacing:-.075em;margin:35px 0 16px}.featured-copy>p{max-width:400px;color:var(--muted);font-size:1.02rem;line-height:1.85;margin:0 0 28px}.stack-list{display:flex;flex-wrap:wrap;gap:7px}.stack-list span{display:inline-block;padding:6px 10px;border:1px solid var(--line);border-radius:8px;background:var(--soft);color:var(--muted);font-size:.76rem;font-weight:600;line-height:1.3}.project-actions{display:flex;flex-wrap:wrap;gap:10px;margin-top:auto;padding-top:36px}.project-primary,.project-secondary{display:inline-flex;align-items:center;gap:18px;min-height:43px;padding:9px 15px;border-radius:10px;font-size:.86rem;font-weight:700;transition:transform .22s ease,box-shadow .22s ease,border-color .22s ease}.project-primary{background:var(--ink);color:var(--bg);border:1px solid var(--ink)}.project-secondary{background:var(--surface);color:var(--ink);border:1px solid var(--line)}.project-primary:hover,.project-secondary:hover{transform:translateY(-2px);box-shadow:0 7px 18px rgba(0,0,0,.1)}.project-primary:active,.project-secondary:active{transform:translateY(0) scale(.98)}.project-visual{position:relative;display:grid;place-items:center;min-width:0;overflow:hidden;background:radial-gradient(circle at 73% 25%,var(--surface) 0,transparent 36%),linear-gradient(140deg,var(--soft),var(--accent-soft));border-left:1px solid var(--line)}.visual-orbit{position:absolute;width:410px;height:410px;border:1px solid var(--line);border-radius:50%;transform:translate(42%, -35%)}.preview-window{position:relative;width:min(82%,410px);aspect-ratio:1.26;border:1px solid var(--line);border-radius:14px;background:var(--surface);box-shadow:0 24px 70px rgba(0,0,0,.16);transform:rotate(-4deg);overflow:hidden}.preview-bar{height:31px;display:flex;align-items:center;justify-content:space-between;padding:0 12px;border-bottom:1px solid var(--line);color:var(--muted);font-size:9px}.preview-dots{display:flex;gap:4px}.preview-dots i{width:5px;height:5px;border-radius:50%;background:var(--line)}.preview-url{max-width:62%;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}.preview-menu{font-size:10px;letter-spacing:2px}.preview-body{padding:15px 19px}.preview-nav{display:flex;align-items:center;justify-content:space-between;gap:8px;font-size:9px;border-bottom:1px solid var(--line);padding-bottom:12px}.preview-nav b{font-size:13px;letter-spacing:-.05em}.preview-nav span{color:var(--muted)}.preview-hero{padding:28px 9px 20px}.preview-hero>span{display:block;color:var(--muted);font-size:7px;letter-spacing:.14em;font-weight:700}.preview-hero strong{display:block;font-size:clamp(20px,3vw,37px);letter-spacing:-.08em;line-height:1.25;margin:10px 0 13px}.preview-hero strong span{color:var(--muted)}.preview-hero i{display:block;width:73%;height:4px;border-radius:5px;background:var(--line);margin:7px 0}.preview-hero i:last-child{width:52%}.preview-tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px;padding:0 9px}.preview-tiles span{height:30px;border-radius:5px;background:var(--soft);border:1px solid var(--line)}.visual-caption{position:absolute;right:23px;bottom:19px;color:var(--muted);font-size:.68rem;font-weight:700;letter-spacing:.14em}.more-projects{margin-top:70px}.project-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:18px}.project-card{display:flex;flex-direction:column;min-height:340px;padding:25px;border:1px solid var(--line);border-radius:20px;background:var(--surface);transition:transform .25s ease,box-shadow .25s ease,border-color .25s ease}.project-card:hover{transform:translateY(-3px);box-shadow:var(--shadow);border-color:var(--muted)}.card-number{font-size:.72rem;color:var(--muted);letter-spacing:.13em}.card-symbol{display:grid;place-items:center;width:53px;height:53px;margin:21px 0;border-radius:14px;background:var(--accent-soft);font-size:1.7rem;font-weight:700}.project-card h3{font-size:1.65rem;letter-spacing:-.05em;margin:8px 0}.project-card h3 a:hover{text-decoration:underline;text-underline-offset:4px}.project-card p{color:var(--muted);font-size:.91rem;line-height:1.7;margin:0 0 23px}.card-bottom{display:flex;align-items:end;justify-content:space-between;gap:8px;margin-top:auto}.card-bottom>a{white-space:nowrap;font-size:.81rem;font-weight:700}.card-bottom>a:hover{text-decoration:underline}.projects-empty{padding:55px 28px;border:1px dashed var(--line);border-radius:18px;color:var(--muted);text-align:center}
  @media(max-width:850px){.featured-project{grid-template-columns:1fr}.project-visual{grid-row:1;min-height:300px;border-left:0;border-bottom:1px solid var(--line)}.featured-copy h2{margin-top:20px}.project-actions{padding-top:28px}}@media(max-width:700px){.projects-head{padding:54px 0 35px}.project-grid{grid-template-columns:1fr}.featured-project{border-radius:20px}.project-visual{min-height:250px}.preview-window{width:min(75%,320px)}.preview-hero{padding-top:18px}.preview-hero strong{font-size:24px}.featured-copy{padding:27px}.visual-caption{font-size:.57rem}}
  @media(max-width:400px){.project-visual{min-height:220px}.preview-hero{padding:10px 5px 0}.preview-hero strong{font-size:19px;margin:5px 0}.preview-hero i,.preview-tiles{display:none}}
  @media(prefers-reduced-motion:reduce){.project-primary,.project-secondary,.project-card{transition:none}.project-primary:hover,.project-secondary:hover,.project-card:hover{transform:none}}
</style>
