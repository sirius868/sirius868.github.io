---
import { site } from '../site.config';
import type { Locale } from '../lib/locale';

interface Props { locale: Locale; }
const { locale } = Astro.props;
const en = locale === 'en';
---

{site.links.length > 0 && <section class="contact-panel" aria-labelledby="contact-heading">
  <div class="contact-copy">
    <div class="eyebrow">CONNECT</div>
    <h2 id="contact-heading">{en ? 'Find me' : '找到我'}</h2>
    <p>{en ? 'Projects and code updates live on GitHub.' : '项目和代码更新会放在 GitHub。'}</p>
  </div>
  <div class="contact-links">
    {site.links.map((link) => <a class="contact-link" href={link.url} target="_blank" rel="noopener noreferrer">
      {link.label === 'GitHub' && <svg class="contact-icon" viewBox="0 0 16 16" width="30" height="30" fill="currentColor" aria-hidden="true"><path d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.22.48-2.69-.94-2.69-.94-.36-.92-.88-1.17-.88-1.17-.72-.49.05-.48.05-.48.8.06 1.22.82 1.22.82.71 1.21 1.87.86 2.33.65.07-.52.28-.86.51-1.06-1.77-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.65 7.65 0 018 4.73c.68 0 1.36.09 2 .27 1.53-1.03 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.28.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.19 0 .21.15.46.55.38A8.01 8.01 0 0016 8c0-4.42-3.58-8-8-8z"/></svg>}
      <span class="contact-label"><strong>{link.label}</strong><small>{new URL(link.url).host}</small></span>
      <span class="contact-external" aria-hidden="true">↗</span>
    </a>)}
  </div>
</section>}

<style>
  .contact-panel{display:grid;grid-template-columns:minmax(0,1fr) minmax(225px,280px);align-items:center;gap:28px;margin-top:55px;padding:32px;border:1px solid var(--line);border-radius:22px;background:linear-gradient(135deg,var(--surface),var(--soft));box-shadow:var(--shadow)}
  .contact-copy h2{margin:10px 0 8px;font-size:clamp(1.5rem,3vw,2rem);line-height:1.2;letter-spacing:-.05em}
  .contact-copy p{max-width:340px;margin:0;color:var(--muted);font-size:.92rem;line-height:1.7}
  .contact-links{display:grid;gap:10px}
  .contact-link{display:flex;align-items:center;gap:14px;min-width:0;padding:17px;border:1px solid var(--line);border-radius:16px;background:var(--surface);box-shadow:0 5px 18px rgba(0,0,0,.035);transition:transform .22s ease,border-color .22s ease,box-shadow .22s ease}
  .contact-link:hover{transform:translateY(-2px);border-color:var(--muted);box-shadow:0 10px 26px rgba(0,0,0,.09)}
  .contact-icon{flex:none;color:var(--ink)}
  .contact-label{display:grid;min-width:0;line-height:1.35}.contact-label strong{font-size:1rem}.contact-label small{overflow:hidden;color:var(--muted);font-size:.75rem;text-overflow:ellipsis;white-space:nowrap}
  .contact-external{margin-left:auto;color:var(--muted);font-size:1.1rem}
  @media(max-width:620px){.contact-panel{grid-template-columns:1fr;gap:22px;padding:24px}.contact-link{padding:15px}}
  @media(prefers-reduced-motion:reduce){.contact-link{transition:none}.contact-link:hover{transform:none}}
</style>
