---
import '../styles/global.css';
import { site, siteUrl } from '../site.config';
import { copy, localizedPath, type Locale } from '../lib/locale';

interface Props {
  title: string;
  description: string;
  pathname?: string;
  section?: 'home' | 'blog' | 'notes' | 'projects' | 'about' | 'search';
  locale?: Locale;
  alternatePath?: string;
  contentLanguage?: Locale;
  translated?: boolean;
  homeHeaderSync?: boolean;
}

const { title, description, pathname = Astro.url.pathname, section, locale = 'zh', alternatePath, contentLanguage = locale, translated = true, homeHeaderSync = false } = Astro.props;
const t = copy[locale];
const fullTitle = title === site.name ? site.name : `${title} · ${site.name}`;
const canonical = new URL(pathname, siteUrl).toString();
const switchPath = alternatePath || (locale === 'en' ? pathname.replace(/^\/en(?=\/)/, '') || '/' : localizedPath(pathname, 'en'));
const nav = [
  { key: 'home', label: t.home, href: localizedPath('/', locale) },
  { key: 'blog', label: t.blog, href: localizedPath('/blog/', locale) },
  { key: 'notes', label: t.notes, href: localizedPath('/notes/', locale) },
  { key: 'projects', label: t.projects, href: localizedPath('/projects/', locale) },
  { key: 'about', label: t.about, href: localizedPath('/about/', locale) },
  { key: 'search', label: t.search, href: localizedPath('/search/', locale) }
] as const;
---
<!doctype html>
<html lang={contentLanguage === 'en' ? 'en' : 'zh-CN'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/png" href="/favicon.png?v=2" />
    <meta name="theme-color" content="#ffffff" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {translated && <link rel="alternate" hreflang={locale === 'en' ? 'zh-CN' : 'en'} href={new URL(switchPath, siteUrl).toString()} />}
    <link rel="alternate" type="application/rss+xml" title={`${site.name} RSS`} href={new URL('/rss.xml', siteUrl).toString()} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <script is:inline>
      (() => {
        try {
          const choice = localStorage.getItem('yhblog-theme') || 'light';
          const dark = choice === 'dark' || (choice === 'system' && matchMedia('(prefers-color-scheme: dark)').matches);
          document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        } catch {
          document.documentElement.dataset.theme = 'light';
        }
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main">{t.skip}</a>
    <div class="site-shell">
      <header class="site-header" data-home-header-sync={homeHeaderSync ? 'true' : undefined}>
        <a class="brand" href={localizedPath('/', locale)} aria-label={`blog ${t.home}`}>
          <img class="brand-logo" src="/images/yh-logo.png" alt="" width="42" height="38" />
          <span>blog</span>
        </a>
        <nav class="desktop-nav" aria-label={t.mainNav}>
          {nav.map((item) => <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>)}
        </nav>
        <div class="header-actions">
          <a class="language-switch" href={switchPath} aria-label={locale === 'en' ? 'Switch to Chinese' : 'Switch to English'}>{locale === 'en' ? '中文' : 'EN'}</a>
          <div class="theme-picker">
            <button id="theme-trigger" class="theme-trigger" type="button" aria-label={t.theme} aria-haspopup="menu" aria-controls="theme-menu" aria-expanded="false">
              <svg viewBox="0 0 24 24" width="17" height="17" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2m0 16v2M4.93 4.93l1.42 1.42m11.3 11.3 1.42 1.42M2 12h2m16 0h2M4.93 19.07l1.42-1.42m11.3-11.3 1.42-1.42"/></svg>
              <span id="theme-label">{t.light}</span>
              <svg class="theme-chevron" viewBox="0 0 20 20" width="14" height="14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" aria-hidden="true"><path d="m5 7 5 5 5-5"/></svg>
            </button>
            <div id="theme-menu" class="theme-menu" role="menu" aria-label={t.theme} hidden>
              <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="light"><span class="theme-option-icon" aria-hidden="true">☀</span><span>{t.light}</span><span class="theme-check" aria-hidden="true">✓</span></button>
              <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="dark"><span class="theme-option-icon" aria-hidden="true">☾</span><span>{t.dark}</span><span class="theme-check" aria-hidden="true">✓</span></button>
              <button type="button" role="menuitemradio" aria-checked="false" data-theme-option="system"><span class="theme-option-icon" aria-hidden="true">◑</span><span>{t.system}</span><span class="theme-check" aria-hidden="true">✓</span></button>
            </div>
          </div>
          <details class="mobile-menu">
            <summary aria-label={t.openMenu}><span></span><span></span><span></span></summary>
            <nav aria-label={t.mobileNav}>
              {nav.map((item) => <a href={item.href} aria-current={section === item.key ? 'page' : undefined}>{item.label}</a>)}
            </nav>
          </details>
        </div>
      </header>
      <main id="main"><slot /></main>
      <footer class="site-footer">
        <div><strong>{site.name}</strong><span>{t.footer}</span></div>
        <div class="footer-links"><a href={localizedPath('/blog/', locale)}>{t.blog}</a><a href={localizedPath('/notes/', locale)}>{t.notes}</a><a href={localizedPath('/projects/', locale)}>{t.projects}</a><a href={localizedPath('/about/', locale)}>{t.about}</a></div>
        <small>© {new Date().getFullYear()} blog</small>
      </footer>
    </div>
    <script>
      const themeTrigger = document.querySelector<HTMLButtonElement>('#theme-trigger');
      const themeMenu = document.querySelector<HTMLElement>('#theme-menu');
      const themeLabel = document.querySelector<HTMLElement>('#theme-label');
      const themeOptions = [...document.querySelectorAll<HTMLButtonElement>('[data-theme-option]')];
      const media = matchMedia('(prefers-color-scheme: dark)');
      let choice = 'light';
      try { choice = localStorage.getItem('yhblog-theme') || 'light'; } catch { /* current page still works */ }
      if (!['light', 'dark', 'system'].includes(choice)) choice = 'light';
      const apply = () => {
        const dark = choice === 'dark' || (choice === 'system' && media.matches);
        document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', dark ? '#0c0c0d' : '#ffffff');
        if (themeLabel) themeLabel.textContent = themeOptions.find((option) => option.dataset.themeOption === choice)?.querySelector('span:nth-child(2)')?.textContent || choice;
        for (const option of themeOptions) option.setAttribute('aria-checked', String(option.dataset.themeOption === choice));
      };
      const closeThemeMenu = (restoreFocus = false) => {
        if (!themeMenu || !themeTrigger) return;
        themeMenu.hidden = true;
        themeTrigger.setAttribute('aria-expanded', 'false');
        if (restoreFocus) themeTrigger.focus({ preventScroll: true });
      };
      themeTrigger?.addEventListener('click', () => {
        if (!themeMenu) return;
        const opening = themeMenu.hidden;
        themeMenu.hidden = !opening;
        themeTrigger.setAttribute('aria-expanded', String(opening));
        if (opening) themeOptions.find((option) => option.dataset.themeOption === choice)?.focus({ preventScroll: true });
      });
      for (const option of themeOptions) option.addEventListener('click', () => {
        choice = option.dataset.themeOption || 'light';
        try { localStorage.setItem('yhblog-theme', choice); } catch { /* current page still works */ }
        apply();
        closeThemeMenu(true);
      });
      themeMenu?.addEventListener('keydown', (event) => {
        const current = themeOptions.indexOf(document.activeElement as HTMLButtonElement);
        if (event.key === 'Escape') { event.preventDefault(); closeThemeMenu(true); }
        if (event.key === 'ArrowDown' || event.key === 'ArrowUp') {
          event.preventDefault();
          const step = event.key === 'ArrowDown' ? 1 : -1;
          themeOptions[(current + step + themeOptions.length) % themeOptions.length]?.focus();
        }
      });
      document.addEventListener('pointerdown', (event) => {
        if (themeMenu && !themeMenu.hidden && !themeMenu.contains(event.target as Node) && !themeTrigger?.contains(event.target as Node)) closeThemeMenu();
      });
      media.addEventListener('change', apply);
      apply();

      const header = document.querySelector<HTMLElement>('.site-header');
      const menu = document.querySelector<HTMLDetailsElement>('.mobile-menu');
      const homeHeaderSync = header?.dataset.homeHeaderSync === 'true';
      let previousY = window.scrollY;
      let framePending = false;
      const updateHeader = () => {
        if (!header) return;
        const y = window.scrollY;
        const isScrolled = y > 32;
        header.classList.toggle('is-scrolled', isScrolled);
        if (!isScrolled || menu?.open || header.contains(document.activeElement)) {
          header.classList.remove('is-hidden');
        } else if (y > 180 && y - previousY > (homeHeaderSync ? 1 : 5)) {
          header.classList.add('is-hidden');
        } else if (previousY - y > (homeHeaderSync ? 1 : 5)) {
          header.classList.remove('is-hidden');
        }
        previousY = y;
        framePending = false;
      };
      window.addEventListener('scroll', () => {
        if (!framePending) {
          framePending = true;
          requestAnimationFrame(updateHeader);
        }
      }, { passive: true });
      menu?.addEventListener('toggle', () => {
        if (menu.open) header?.classList.remove('is-hidden');
      });
      updateHeader();
    </script>
  </body>
</html>
